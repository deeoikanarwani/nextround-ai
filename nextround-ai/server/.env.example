PORT=5000
# Local MongoDB, or a free MongoDB Atlas (M0) connection string
MONGODB_URI=mongodb://127.0.0.1:27017/nextround
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# Free key from https://aistudio.google.com/apikey  (optional: without it, built-in heuristic AI is used)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Daily per-user limits enforced by the backend
LIMIT_AI_CALLS_PER_DAY=60
LIMIT_INTERVIEWS_PER_DAY=6
LIMIT_RESUME_ANALYSES_PER_DAY=5
LIMIT_JOB_ANALYSES_PER_DAY=10
